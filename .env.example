# Copy to .env (git-ignored) and adjust. Restrict permissions: chmod 600 .env
# Placeholders only; never put real credentials in this example file.

# --- AI ----------------------------------------------------------------------
# demo      = scripted responses, no AI provider calls, no key needed (default)
# anthropic = Claude API; requires ANTHROPIC_API_KEY (see docs/ai-setup.md)
AI_MODE=demo
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_REFUSAL_FALLBACK=default
AI_MAX_OUTPUT_TOKENS=8000
AI_MAX_MODEL_ROUNDS=6
AI_MAX_TOOL_CALLS_PER_TURN=12
AI_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=2
AI_REQUESTS_PER_USER_PER_MINUTE=10
AI_MAX_CONCURRENT_TURNS=1
AI_DAILY_BUDGET_USD=2.00
AI_MONTHLY_BUDGET_USD=20.00

# --- Access --------------------------------------------------------------------
# Local profile: a fixed developer identity on 127.0.0.1 only.
DEPLOYMENT_PROFILE=local
AUTH_MODE=local
LOCAL_DEV_USER_EMAIL=owner@localhost
ALLOWED_ORIGIN=http://127.0.0.1:8080

# Remote profile (docs/remote-access.md): uncomment and fill in.
# DEPLOYMENT_PROFILE=remote
# AUTH_MODE=cloudflare_access
# ALLOWED_ORIGIN=https://assistant.example.com
# CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# CF_ACCESS_AUDIENCE=your-access-application-aud-tag
# ALLOWED_EMAILS=owner@example.com,tester@example.com
# OWNER_EMAIL=owner@example.com

# --- Limits (defaults shown) ---------------------------------------------------
# MAX_UPLOAD_BYTES=10485760
# MAX_POPULATED_CELLS=100000
# CALC_TIMEOUT_SECONDS=90
